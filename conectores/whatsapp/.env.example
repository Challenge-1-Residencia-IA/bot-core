# Sobrescrevem o config.yaml (todas opcionais)
WHATSAPP_DRY_RUN=true
WHATSAPP_HEADLESS=false
# allowlist = só WHATSAPP_CONTATOS_PERMITIDOS; aberto = qualquer conversa individual, com sessões limitadas
WHATSAPP_MODO_ACESSO=allowlist
# Lista JSON com os nomes exatos dos chats atendidos; vazia = ninguém (fail-closed)
WHATSAPP_CONTATOS_PERMITIDOS=[]
WHATSAPP_PERFIL_DIR=whatsapp_profile
WHATSAPP_REGISTRO_ENTREGAS=data/deliveries.db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

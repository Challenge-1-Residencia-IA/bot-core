# LLM (Ollama). OLLAMA_MODEL deve ser o nome exato mostrado por `ollama list`.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=180

# Fila ARQ entre o conector e o núcleo
REDIS_URL=redis://localhost:6379/0

# 0 desliga a etapa do NeMo Guardrails (fica só a verificação por padrões)
GUARDRAILS_NEMO=1

# PostgreSQL + pgvector (base de checagens). Em produção, a URL do Neon; esquema criado com `alembic upgrade head`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/challenge1
